        "jsCode": "const tree = $json.tree;\n\nconst result = {\n  totalFiles: tree.length,\n  dependencyFiles: [],\n  importantFiles: []\n};\n\nfor (const file of tree) {\n  const path = file.path;\n\n  // Dependency manifests\n  if (\n    path.endsWith(\"package.json\") ||\n    path.endsWith(\"requirements.txt\") ||\n    path.endsWith(\"pom.xml\") ||\n    path.endsWith(\"go.mod\") ||\n    path.endsWith(\"Cargo.toml\")\n  ) {\n    result.dependencyFiles.push({\n      path: file.path,\n      sha: file.sha\n    });\n  }\n\n  // High-value files for architecture understanding\n  if (\n    path === \"README.md\" ||\n    path === \"package.json\" ||\n    path === \"Dockerfile\" ||\n    path === \"docker-compose.yml\"\n  ) {\n    result.importantFiles.push({\n      path: file.path,\n      sha: file.sha\n    });\n  }\n}\n\nreturn [{\n  json: result\n}];"
      },
