# =============================================
# RepoAuditor Backend — Environment Variables
# =============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Supabase PostgreSQL connection string
# Get this from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql+asyncpg://postgres:[YOUR_PASSWORD]@YOUR_SUPABASE_HOST:5432/postgres

# JWT secret key — generate a random string (e.g. openssl rand -hex 32)
JWT_SECRET=your-random-jwt-secret-key

# Resend API key — get from https://resend.com/api-keys
RESEND_API_KEY=your-resend-api-key

# Email sender address — must be verified in Resend (or use onboarding@resend.dev for testing)
EMAIL_FROM=onboarding@resend.dev

# Frontend URL — used in password reset email links and CORS
# Development: http://localhost:8000
# Production:  https://your-app.vercel.app
FRONTEND_URL=http://localhost:8000

# Shared secret for n8n webhook callbacks (generate: openssl rand -hex 24)
WEBHOOK_SECRET=your-webhook-secret

# Razorpay credentials — get from https://dashboard.razorpay.com/app/keys
# Use Test Mode keys for development, Live Mode keys for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Port — set by hosting platforms (Render, Railway). Do not set locally.
# PORT=10000

postgresql+asyncpg://postgres.kperzzuexbeuwmxavvzp:Kushagra1711%40@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres